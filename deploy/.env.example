# Copy to deploy/.env on the VPS and fill in real values (keep OUT of git).
# Source of truth for most values = your current Vercel project env / .env.local.

# --- Image (set by CI or manually) ---------------------------------------
APP_IMAGE=ghcr.io/OWNER/REPO:latest
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Database (Neon cloud — UNCHANGED, copy as-is from Vercel) ------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# ...plus the other PG*/POSTGRES_* vars your app reads (copy the full set).

# --- Neon Auth -----------------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_PROJECT_ID=

# --- App auth ------------------------------------------------------------
AUTH_SECRET=

# --- Server Actions encryption key (CRITICAL when self-hosting) ----------
# Vercel manages this automatically; self-hosted you MUST pin it, else action
# IDs break across rebuilds/restarts. Generate once with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- WireGuard/OpenVPN relay (now on THIS same VPS) ----------------------
# App SSHes to the relay locally. Public host = a name YOU control so future
# routers get a stable endpoint (add relay.safelinkhub.io → 31.97.153.83).
WG_RELAY_HOST=127.0.0.1
WG_RELAY_PUBLIC_HOST=relay.safelinkhub.io
WG_RELAY_SSH_USER=relay
WG_RELAY_SSH_KEY_B64=

# --- Cron auth (see /api/cron/router-health-check) -----------------------
# Reproduce whatever that route checks. If it uses a shared secret, set it here
# and send it from the systemd timer (Authorization header).
# CRON_SECRET=

# --- Dropped when leaving Vercel -----------------------------------------
# VERCEL_OIDC_TOKEN  → not used by app code; do NOT carry it over.
