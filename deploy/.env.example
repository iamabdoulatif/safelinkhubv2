# Copy to deploy/.env on the VPS and fill in real values (keep OUT of git).
# Source of truth for most values = your current Vercel project env / .env.local.

# --- Image (set by CI or manually) ---------------------------------------
APP_IMAGE=ghcr.io/OWNER/REPO:latest
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Database (Neon cloud — UNCHANGED, copy as-is from Vercel) ------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# ...plus the other PG*/POSTGRES_* vars your app reads (copy the full set).

# --- Neon Auth -----------------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_PROJECT_ID=

# --- App auth ------------------------------------------------------------
AUTH_SECRET=

# --- Resend (emails transactionnels : activation compte + mot de passe oublié)
# Clé API Resend + expéditeur. RESEND_FROM DOIT utiliser un domaine vérifié
# côté Resend (mail.safelinkhub.io a le sending activé). Runtime uniquement —
# pas besoin de rebuild pour changer ces valeurs, juste `docker compose up -d`.
RESEND_API_KEY=
RESEND_FROM=SafeLinkHub <noreply@mail.safelinkhub.io>

# --- Server Actions encryption key (CRITICAL when self-hosting) ----------
# Vercel manages this automatically; self-hosted you MUST pin it, else action
# IDs break across rebuilds/restarts. Generate once with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- WireGuard/OpenVPN relay (now on THIS same VPS) ----------------------
# App SSHes to the relay locally. Public host = a name YOU control so future
# routers get a stable endpoint (add relay.safelinkhub.io → 31.97.153.83).
WG_RELAY_HOST=127.0.0.1
WG_RELAY_PUBLIC_HOST=relay.safelinkhub.io
WG_RELAY_SSH_USER=relay
WG_RELAY_SSH_KEY_B64=

# --- GeniusPay (compte PLATEFORME : encaisse les accès distants VPN) ------
# Clés du compte GeniusPay de la plateforme (pas celui des orgs). À copier
# depuis pay.genius.ci → Paramètres → API. Sandbox: pk_sandbox_/sk_sandbox_.
# GENIUSPAY_WEBHOOK_SECRET = le secret whsec_ renvoyé à la création du webhook
# (pay.genius.ci → Webhooks), pointé sur :
#   https://safelinkhub.io/api/payments/geniuspay/webhook  (événement payment.success)
# Runtime uniquement — pas besoin de rebuild pour changer ces valeurs.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# Optionnel — surcharge l'URL de base (par défaut https://pay.genius.ci/api/v1/merchant).
# GENIUSPAY_BASE_URL=
# Drapeau de MASQUAGE : les boutons "Payer en ligne" restent cachés tant que
# ce drapeau n'est pas activé, même avec des clés valides. Mettre à 1 pour
# tester la fonctionnalité, laisser vide/absent en public jusqu'à validation.
GENIUSPAY_CHECKOUT_ENABLED=

# --- Cron auth (see /api/cron/router-health-check) -----------------------
# Reproduce whatever that route checks. If it uses a shared secret, set it here
# and send it from the systemd timer (Authorization header).
# CRON_SECRET=

# --- Dropped when leaving Vercel -----------------------------------------
# VERCEL_OIDC_TOKEN  → not used by app code; do NOT carry it over.
