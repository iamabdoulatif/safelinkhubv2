{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "lara": {
      "type": "http",
      "url": "https://mcp-v2.laratranslate.com/v1"
    },
    "kimi-code": {
      "command": "npx",
      "args": [
        "-y",
        "kimi-mcp-server"
      ]
    },
    "n8n-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://latif225.app.n8n.cloud",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    }
  }
}
