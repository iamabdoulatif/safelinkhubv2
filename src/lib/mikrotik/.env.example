# Example environment variables for running MikroTikProvisioner as a
# standalone script (see README-provisioner.md). Copy to `.env` and fill in
# real values — never commit the real file.

# --- Connection -------------------------------------------------------------
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8729
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=

# --- Interfaces --------------------------------------------------------------
MIKROTIK_WAN_INTERFACE_NAME=E1-WAN-FAI
MIKROTIK_VETH_NAME=MKHMON
MIKROTIK_VETH_ADDRESS=11.11.11.11/28
MIKROTIK_VETH_GATEWAY=11.11.11.1

# --- Bridges ------------------------------------------------------------------
MIKROTIK_HOTSPOT_BRIDGE_NAME=HOTSPOT
MIKROTIK_DOCKER_BRIDGE_NAME=DOCKERS
# Comma-separated list of physical/WiFi ports attached to the hotspot bridge.
MIKROTIK_HOTSPOT_BRIDGE_PORTS=ether2,ether3,ether4,ether5,wifi1,wifi2

# --- IP / DHCP / DNS ----------------------------------------------------------
MIKROTIK_HOTSPOT_ADDRESS=10.0.0.1
MIKROTIK_HOTSPOT_PREFIX_BITS=16
MIKROTIK_DHCP_POOL_NAME=pool-hotspot
MIKROTIK_DHCP_POOL_RANGES=10.0.0.2-10.0.255.254
MIKROTIK_DHCP_SERVER_NAME=dhcp-hotspot
MIKROTIK_DNS_SERVERS=208.67.222.222,8.8.8.8

# --- System -------------------------------------------------------------------
MIKROTIK_IDENTITY=HSPT-WIFIVILLAGE
MIKROTIK_TIMEZONE=Africa/Abidjan
# Comma-separated list of NTP server addresses.
MIKROTIK_NTP_SERVERS=196.200.131.160,196.10.52.57
MIKROTIK_ENABLE_CLOUD_DDNS=true
MIKROTIK_DISABLE_SSH=true
MIKROTIK_DISABLE_API_SSL=true
