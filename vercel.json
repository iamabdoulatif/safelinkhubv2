{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/router-health-check",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/voucher-expiry-sync",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/router-backup",
      "schedule": "30 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "safelinkhub.vercel.app" }],
      "destination": "https://safelinkhub.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "safelinkhub.vercel.app" }],
      "destination": "https://safelinkhub.io/:path*",
      "permanent": true
    }
  ]
}
