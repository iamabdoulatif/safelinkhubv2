# Connection ------------------------------------------------------------
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8729
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=
# Set to "false" to use plain API (port 8728) instead of API-SSL.
MIKROTIK_TLS=true

# Below: every DEFAULT_CONFIG key in safelinkhub-auto-provision.js can be
# overridden via MIKROTIK_<KEY_IN_SNAKE_CASE>. Uncomment and edit as needed
# — anything left commented keeps its default from the script.

# WiFi
# MIKROTIK_SSID=DU BONHEUR WIFI
# MIKROTIK_WIFI_COUNTRY=Ivory Coast
# MIKROTIK_WIFI_DISABLED=no

# Hotspot
# MIKROTIK_HOTSPOT_PROFILE_NAME=DUBONHEUR
# MIKROTIK_DNS_NAME=dubonheur.ci
# MIKROTIK_HTML_DIRECTORY=DUBONHEUR
# MIKROTIK_HTTP_COOKIE_LIFETIME=52w1d
# MIKROTIK_HOTSPOT_USERS=admin,president01@

# System
# MIKROTIK_IDENTITY=HSPT-DUBONHEUR
# MIKROTIK_TIMEZONE=Africa/Abidjan

# Networking
# MIKROTIK_WAN_INTERFACE=E1-WAN-FAI
# MIKROTIK_DEFAULT_WAN=ether1
# MIKROTIK_LAN_BRIDGE_NAME=HOTSPOT
# MIKROTIK_LAN_BRIDGE_PORTS=ether2,ether3,ether4,ether5,wifi1,wifi2
# MIKROTIK_LAN_ADDRESS=10.0.0.1/8
# MIKROTIK_LAN_NETWORK=10.0.0.0
# MIKROTIK_DHCP_POOL_NAME=POOL-HOTSPOT
# MIKROTIK_DHCP_POOL_RANGE=10.0.0.2-10.255.255.254
# MIKROTIK_DHCP_SERVER_NAME=dhcp1
# MIKROTIK_DNS_SERVERS=208.67.222.222,8.8.8.8
# MIKROTIK_NTP_SERVERS=196.200.131.160,196.10.52.57

# Container / Docker (MikHmon)
# MIKROTIK_CONTAINER_BRIDGE_NAME=CONTAINERS
# MIKROTIK_VETH_NAME=MIKHMON
# MIKROTIK_CONTAINER_IP=11.11.11.11/28
# MIKROTIK_CONTAINER_GATEWAY=11.11.11.1
# MIKROTIK_CONTAINER_NETWORK=11.11.11.0
# MIKROTIK_CONTAINER_VETH_MAC=60:6B:5F:65:F4:8C
# MIKROTIK_CONTAINER_MAC=60:6B:5F:65:F4:8D
# MIKROTIK_CONTAINER_NAME=mikhmonv3-safelinkhub:latest
# MIKROTIK_CONTAINER_IMAGE=latif225/mikhmonv3-safelinkhub:latest
# MIKROTIK_CONTAINER_LAYER_DIR=/flash/mikhmon-app
# MIKROTIK_CONTAINER_ROOT_DIR=/mikhmon-app
# MIKROTIK_CONTAINER_REGISTRY_URL=https://registry-1.docker.io
# MIKROTIK_CONTAINER_TMPDIR=/tmp
# MIKROTIK_CONTAINER_LAYER_DIR_CONFIG=/flash/mikhmon-layers

# NAT / remote access
# MIKROTIK_REMOTE_ACCESS_PORT=8088
# MIKROTIK_DOCKER_WEB_PORT=8087

# Disk
# MIKROTIK_TMPFS_SLOT=tmp
# MIKROTIK_TMPFS_MAX_SIZE=150000000

# Hardening / API access
# MIKROTIK_USER_GROUP_NAME=safelinkhub-group
# MIKROTIK_USER_GROUP_POLICY=read,write,test,sensitive,api,!local,!telnet,!ssh,!ftp,!reboot,!policy,!winbox,!password,!web,!sniff,!romon,!rest-api
# MIKROTIK_WWW_PORT=85

# Misc
# MIKROTIK_SCHEDULER_CLEAN_JOB_NAME=CLEAN_JOB
# MIKROTIK_EXPORT_SCRIPT_NAME=export-all
